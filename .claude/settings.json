{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(powershell *Tools/Agent/*.ps1*)",
      "Bash(powershell.exe *Tools/Agent/*.ps1*)",
      "Bash(git status*)",
      "Bash(git diff --name-only*)",
      "Bash(git diff --stat*)",
      "Bash(git log -n*)"
    ],
    "deny": [
      "Read(./Library/*)",
      "Read(./Library/APIUpdater/**)",
      "Read(./Library/Artifacts/**)",
      "Read(./Library/Bee/**)",
      "Read(./Library/BurstCache/**)",
      "Read(./Library/DataStore/**)",
      "Read(./Library/PackageManager/**)",
      "Read(./Library/ScriptAssemblies/**)",
      "Read(./Library/Search/**)",
      "Read(./Library/ShaderCache/**)",
      "Read(./Library/StateCache/**)",
      "Read(./Temp/**)",
      "Read(./Logs/*-prev.log)",
      "Read(./Logs/AssetImportWorker*)",
      "Read(./Logs/*.jsonl)",
      "Read(./UserSettings/**)",
      "Read(./obj/**)",
      "Read(./Build/**)",
      "Read(./Builds/**)",
      "Read(./*.csproj)",
      "Read(./*.sln)",
      "Read(./*.slnx)",

      "Read(./Assets/TextMesh Pro/**)",
      "Read(./Assets/Synty/**)",
      "Read(./Assets/Polygon*/**)",
      "Read(./Assets/Plugins/**)",
      "Read(./Assets/Samples/**)",

      "Read(./**/*.meta)",
      "Read(./**/*.unity)",
      "Read(./**/*.shadergraph)",
      "Read(./**/*.anim)",
      "Read(./**/*SDF.asset)",
      "Read(./**/LightingData.asset)",
      "Read(./**/NavMesh*.asset)",

      "Read(./Assets/**/*.png)",
      "Read(./Assets/**/*.jpg)",
      "Read(./Assets/**/*.jpeg)",
      "Read(./Assets/**/*.tga)",
      "Read(./Assets/**/*.tif)",
      "Read(./Assets/**/*.tiff)",
      "Read(./Assets/**/*.exr)",
      "Read(./Assets/**/*.hdr)",
      "Read(./**/*.psd)",
      "Read(./**/*.fbx)",
      "Read(./**/*.obj)",
      "Read(./**/*.blend)",
      "Read(./**/*.blend1)",
      "Read(./**/*.wav)",
      "Read(./**/*.ogg)",
      "Read(./**/*.mp3)",
      "Read(./**/*.aif)",
      "Read(./**/*.aiff)",
      "Read(./**/*.ttf)",
      "Read(./**/*.otf)",
      "Read(./**/*.mp4)",
      "Read(./**/*.mov)",
      "Read(./**/*.dll)",
      "Read(./**/*.pdb)",
      "Read(./**/*.unitypackage)",

      "Edit(./**/*.unity)",
      "Edit(./**/*.prefab)",
      "Edit(./**/*.asset)",
      "Edit(./**/*.meta)",
      "Edit(./**/*.mat)",
      "Edit(./**/*.controller)",
      "Edit(./**/*.anim)"
    ]
  }
}
